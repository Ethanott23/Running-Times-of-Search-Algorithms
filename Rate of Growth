import time
import random
from search_algorithms import recursive_binary_search, iterative_binary_search, sequential_search

def measure_time(search_fn, arr, target, *args):
    start = time.perf_counter()
    search_fn(arr, target, *args) if args else search_fn(arr, target)
    end = time.perf_counter()
    return (end - start) * 1_000_000  # convert to microseconds

sizes = [5000, 50000, 100000, 150000, 1000000]
trials = 5

for size in sizes:
    arr = sorted(random.sample(range(size * 10), size))
    target = random.choice(arr)

    seq_times = [measure_time(sequential_search, arr, target) for _ in range(trials)]
    iter_times = [measure_time(iterative_binary_search, arr, target) for _ in range(trials)]
    rec_times = [measure_time(recursive_binary_search, arr, target, 0, len(arr)-1) for _ in range(trials)]

    print(f"\nArray size: {size}")
    print(f"Sequential avg: {sum(seq_times)/trials:.2f} µs")
    print(f"Iterative Binary avg: {sum(iter_times)/trials:.2f} µs")
    print(f"Recursive Binary avg: {sum(rec_times)/trials:.2f} µs")
