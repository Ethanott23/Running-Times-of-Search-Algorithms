# ----------------------------------------------------------
# Part 3: Experimental Runtime Measurement
# ----------------------------------------------------------

print("\n=== Part 3: Experimental Runtime Measurement ===")

def measure_time(search_func, arr, target, repeats=5):
    """Measure average execution time (in microseconds)."""
    total_time = 0
    for _ in range(repeats):
        start = time.perf_counter()
        if search_func.__name__ == "recursive_binary_search":
            search_func(arr, target, 0, len(arr) - 1)
        else:
            search_func(arr, target)
        end = time.perf_counter()
        total_time += (end - start)
    avg_time_micro = (total_time / repeats) * 1e6
    return avg_time_micro


sizes = [100, 1000, 5000, 10000, 50000]
results = []

for n in sizes:
    arr = sorted(random.sample(range(1, n * 10), n))
    target = random.choice(arr)  # successful search

    seq_time = measure_time(sequential_search, arr, target)
    iter_time = measure_time(iterative_binary_search, arr, target)
    rec_time = measure_time(recursive_binary_search, arr, target)

    results.append((n, seq_time, iter_time, rec_time))
